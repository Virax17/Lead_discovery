GOOGLE_PLACES_API_KEY=<your-key>
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lead_discovery
APP_SECRET_KEY=dev_secret_key_change_me_in_prod

BOOTSTRAP_ADMIN_USERNAME=a.i@tritorc.com
BOOTSTRAP_ADMIN_PASSWORD=<set-admin-password>
BOOTSTRAP_ADMIN_CREDIT_LIMIT=1000
BOOTSTRAP_USER_USERNAME=test
BOOTSTRAP_USER_PASSWORD=<set-user-password>
BOOTSTRAP_USER_CREDIT_LIMIT=1000

# Comma-separated frontend origin(s) allowed to call this API in production.
# Leave empty for local dev (defaults to the Vite dev server on localhost).
# Vercel example: CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Optional: store exports in S3 instead of local disk (recommended for production hosts).
# Leave all three empty to keep using local disk (backend/exports/) as today.
S3_BUCKET=
S3_REGION=
S3_PREFIX=exports/
